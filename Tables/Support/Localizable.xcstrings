    "Macros.Save.Unencodable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ contains characters this workbook's macros cannot store. Excel keeps macro code in the workbook's original language encoding."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ に、このブックのマクロに保存できない文字が含まれています。Excel はマクロのコードをブック作成時の言語の文字コードで保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 이 통합 문서의 매크로에 저장할 수 없는 문자가 있습니다. Excel은 매크로 코드를 통합 문서의 원래 언어 인코딩으로 저장합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 包含此工作簿的宏无法存储的字符。Excel 会以工作簿原始语言的编码存储宏代码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 包含此活頁簿的巨集無法儲存的字元。Excel 會以活頁簿原始語言的編碼儲存巨集程式碼。"
          }
        }
      }
    },
