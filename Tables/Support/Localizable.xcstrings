        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@'은(는) A1:C10 같은 범위가 아닙니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是区域（如 A1:C10）。"
