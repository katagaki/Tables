      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macros run inside this workbook only. They cannot reach your files, other apps or the internet, and Undo takes back everything a macro did."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マクロはこのブックの中でのみ実行されます。ファイルや他のアプリ、インターネットにはアクセスできず、マクロによる変更はすべて取り消すことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매크로는 이 통합 문서 안에서만 실행됩니다. 파일, 다른 앱, 인터넷에는 접근할 수 없으며, 매크로가 변경한 내용은 모두 실행 취소할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宏只在此工作簿内运行，无法访问你的文件、其他应用或互联网。宏所做的一切都可以撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "巨集只會在此活頁簿內執行，無法存取你的檔案、其他 App 或網際網路。巨集所做的一切都可以還原。"
