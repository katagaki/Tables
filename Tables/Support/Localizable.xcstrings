      }
    },
    "Automation.Error.LastSheet" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A workbook has to keep at least one sheet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークブックには少なくとも1つのシートが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통합 문서에는 시트가 하나 이상 있어야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作簿必须至少保留一个工作表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "活頁簿至少必須保留一個工作表。"
          }
        }
      }
    },
    "Automation.Error.OutsideSheet" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is beyond the largest sheet Tables can hold."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は Tables で扱える最大のシートを超えています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) Tables가 담을 수 있는 가장 큰 시트를 벗어납니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 超出了 Tables 可容纳的最大工作表范围。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 超出了 Tables 可容納的最大工作表範圍。"
          }
        }
      }
    },
